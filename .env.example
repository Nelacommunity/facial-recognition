# Set at least one model provider. The router ("auto") uses whatever is configured.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local models: run Ollama and uncomment (the router then can use it).
# OLLAMA_HOST=127.0.0.1:11434

# Required in production: signs UI actions and session cookies.
AIX_SECRET_KEY=

# Supabase (Project Settings → API). The anon/publishable key is used server-side only, with each
# user's own access token, so row-level security applies to every query.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# Only for projects still on the legacy HS256 JWT secret (Project Settings → JWT Keys). Projects using
# signing keys are verified against their JWKS and don't need it.
SUPABASE_JWT_SECRET=

# Encrypts face embeddings before they are stored in Supabase. Generate once and keep it safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing it makes existing enrollments unreadable (people must re-enroll).
FACEID_ENCRYPTION_KEY=
